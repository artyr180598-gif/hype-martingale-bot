[Unit]
Description=Quantitative Crypto Futures Intelligence Platform Service
After=network.target postgresql.service redis.service

[Service]
Type=simple
User=quant
Group=quant
WorkingDirectory=/opt/quant-platform
Environment="PATH=/opt/quant-platform/.venv/bin:/usr/local/bin:/usr/bin"
EnvironmentFile=/opt/quant-platform/.env
ExecStart=/opt/quant-platform/.venv/bin/python -m src.main
Restart=always
RestartSec=5s

# Security Hardening Sandbox Directives
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/quant-platform/data /opt/quant-platform/logs
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
