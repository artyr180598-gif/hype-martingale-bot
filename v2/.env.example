# ============================================================
#  HYPE ADVISOR v2 — конфигурация
#  Скопируйте в .env (в корень проекта или в v2/.env) и правьте.
#  Всё опционально: без единого ключа бот работает в демо-режиме,
#  а недостающие проверки честно помечает в отчёте.
#
#  Имя переменной = имя поля в v2/config.py (без префиксов).
#  Проверить, что сейчас включено:  python -m v2 status
# ============================================================

# ── ПРИЛОЖЕНИЕ / ЛОГИ ─────────────────────────────────────
LOG_LEVEL=INFO
# true — логи в JSON (для Loki/CloudWatch/Datadog)
LOG_JSON=false

# ── РЕЖИМ ДАННЫХ ──────────────────────────────────────────
# auto — живые провайдеры + демо-подстраховка (помечается в отчёте)
# live — только живые источники
# demo — синтетический рынок, работает офлайн и без ключей
DATA_MODE=auto

# ── СЕТЬ / ОТКАЗОУСТОЙЧИВОСТЬ ─────────────────────────────
HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_BASE=0.5
HTTP_CONCURRENCY=8
REQUESTS_PER_SECOND=6
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_COOLDOWN_SECONDS=60

# ── WEBSOCKET (тикеры в реальном времени) ─────────────────
USE_WEBSOCKET=true
WS_PING_INTERVAL_SECONDS=20
WS_RECONNECT_BASE_SECONDS=1
WS_RECONNECT_MAX_SECONDS=60
WS_STALE_SECONDS=45

# ══════════════════════════════════════════════════════════
#  УРОВЕНЬ 1 — БЫСТРЫЙ СКАНЕР
# ══════════════════════════════════════════════════════════
SCAN_L1_ENABLED=true
# оборот за 5 минут, USD
L1_MIN_VOLUME_5M_USD=500000
# число транзакций за 5 минут (buys + sells)
L1_MIN_TX_5M=100
# минимальная ликвидность пула
L1_MIN_LIQUIDITY_USD=50000
# шире — не торгуем
L1_MAX_SPREAD_PCT=5
# совсем свежие пулы слишком шумные
L1_MIN_PAIR_AGE_HOURS=1
L1_MAX_PAIR_AGE_HOURS=43800
L1_QUOTE_WHITELIST=USDC,USDT,WETH,WSOL,WBNB,BUSD,DAI
L1_BLOCKLIST_SYMBOLS=USDC,USDT,DAI,BUSD,USD1,WETH,WSOL,WBNB,WBTC
# сколько кандидатов пропустить на уровень 2
L1_MAX_CANDIDATES=60

# ══════════════════════════════════════════════════════════
#  УРОВЕНЬ 2 — СКАМ-ФИЛЬТР
# ══════════════════════════════════════════════════════════
SCAN_L2_ENABLED=true

# холдеры
L2_CHECK_HOLDERS=true
L2_MAX_TOP10_PCT=40
L2_MAX_TOP1_PCT=25
L2_MIN_HOLDERS=200

# блокировка ликвидности
L2_CHECK_LP_LOCK=true
L2_MIN_LP_LOCKED_PCT=80
L2_MIN_LP_LOCK_DAYS=180

# контракт
L2_CHECK_CONTRACT=true
L2_BLOCK_IF_MINTABLE=true
L2_BLOCK_IF_BLACKLIST=true
L2_BLOCK_IF_HONEYPOT=true
L2_MAX_BUY_TAX_PCT=10
L2_MAX_SELL_TAX_PCT=10
# строгий режим: торговать только верифицированные контракты
L2_REQUIRE_VERIFIED_SOURCE=false

# ликвидность относительно капитализации
L2_MIN_LIQ_TO_MCAP=0.03
L2_MAX_LIQ_TO_MCAP=0.95
L2_CONCURRENCY=6

# ══════════════════════════════════════════════════════════
#  УРОВЕНЬ 3 — ОНЧЕЙН (профиль деплоера)
#  Нужен ETHERSCAN_API_KEY / BSCSCAN_API_KEY, иначе уровень
#  помечается как degraded (не блокирует токен молча)
# ══════════════════════════════════════════════════════════
SCAN_L3_ENABLED=true
L3_MIN_DEPLOYER_AGE_DAYS=7
L3_MAX_DEPLOYER_TOKENS=25
L3_MAX_DEPLOYER_FUNDED_AGE_HOURS=48
L3_MIN_DEPLOYER_TX_COUNT=5
L3_BLOCK_IF_DEPLOYER_SOLD=true
L3_CONCURRENCY=4

# ── СКАНЕР: ОБЩЕЕ ─────────────────────────────────────────
SCAN_INTERVAL_SECONDS=300
SCAN_TOP_RESULTS=20
SCAN_CACHE_TTL_SECONDS=45
SCAN_MIN_FINAL_SCORE=45

# ── АНАЛИЗ ПО ЗАПРОСУ ─────────────────────────────────────
ANALYSIS_TREND_TF=1h
ANALYSIS_ACCUM_TF=15m
ANALYSIS_BARS=300
# под какой объём считать проскальзывание
ANALYSIS_ENTRY_SIZE_USD=5000
ANALYSIS_SOCIAL_WINDOW_HOURS=2
ANALYSIS_ORDERBOOK_DEPTH=50

# ══════════════════════════════════════════════════════════
#  РИСК-МЕНЕДЖЕР (уровни считаются от ATR)
# ══════════════════════════════════════════════════════════
ATR_PERIOD=14
ATR_SL_MULTIPLIER=1.8
ATR_TP_MULTIPLIER=3.6
ATR_MAX_SL_MULTIPLIER=3.5
ATR_MIN_SL_MULTIPLIER=0.8
MIN_RISK_REWARD=2.0
RISK_PER_TRADE_PCT=1.0
MAX_POSITION_PCT=10.0
MAX_LEVERAGE=5
# риск выше этого значения → «Не входить»
MAX_RISK_SCORE_TO_ENTER=6
TRAILING_ATR_MULTIPLIER=2.5
DEFAULT_DEPOSIT_USD=1000
TAKER_FEE_PCT=0.06

# ══════════════════════════════════════════════════════════
#  ИСПОЛНЕНИЕ ОРДЕРОВ
#  paper   — виртуальные сделки в журнал (безопасно, по умолчанию)
#  dry_run — всё считается, ничего не пишется и не отправляется
#  live    — реальная отправка (нужны ОБА флага ниже + ключи)
# ══════════════════════════════════════════════════════════
EXECUTOR_MODE=paper
EXECUTOR_ALLOW_LIVE=false
EXECUTOR_JOURNAL_PATH=./data/v2_orders.jsonl

# ══════════════════════════════════════════════════════════
#  ПРОВАЙДЕРЫ ДАННЫХ (все ключи опциональны)
# ══════════════════════════════════════════════════════════
DEXSCREENER_ENABLED=true
GECKOTERMINAL_ENABLED=true
GOPLUS_ENABLED=true
RUGDOC_ENABLED=false
ETHERSCAN_API_KEY=
BSCSCAN_API_KEY=
SOLSCAN_API_KEY=
MORALIS_API_KEY=
# X (Twitter) API v2 — без него соцфон оценивается эмуляцией
X_BEARER_TOKEN=
LUNACRUSH_API_KEY=

# ── CEX: свечи/стакан для листингованных токенов ──────────
CEX_ENABLED=true
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=false
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ══════════════════════════════════════════════════════════
#  AI (OpenAI-совместимый API)
#  Без ключа работают rule-based заглушки — бот не ломается
# ══════════════════════════════════════════════════════════
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
AI_ENABLED=true
AI_CONTRACT_ANALYSIS=true
AI_SOCIAL_SCREENING=true
AI_TIMEOUT_SECONDS=20
AI_MAX_TOKENS=700

# ── TELEGRAM / API ────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
HOST=0.0.0.0
PORT=8100
