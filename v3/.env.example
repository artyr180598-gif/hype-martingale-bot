# HYPE v3 — Futures Signal Intelligence (USDT perpetual)
# Optional overrides for the production signal engine. Values in root `.env`
# are also read (see v3/config.py).

# Data mode: auto (live + demo degraded), live (strict), demo
MARKET_DATA_MODE=auto
HTTP_TIMEOUT_SECONDS=12
HTTP_MAX_RETRIES=3
SCAN_INTERVAL_SECONDS=600
SCAN_TOP=20
SCAN_MIN_TURNOVER_USD=20000000

# Timeframes (order fast -> slow)
TIMEFRAMES=1m,5m,15m,1h,4h
ENTRY_TF=15m
INTERMEDIATE_TF=1h
MACRO_TF=4h
ANALYSIS_BARS=400

# Data freshness / liquidity
MAX_DATA_AGE_SECONDS=90
MAX_SPREAD_PCT=0.35
MIN_ORDERBOOK_DEPTH_USD=250000

# Scoring / no-trade
CONFIDENCE_MIN=0.45
QUALITY_MIN=55
S_TIER_MIN=82
A_TIER_MIN=72
B_TIER_MIN=62
C_TIER_MIN=50
SHOW_TIER_MIN=72
COOLDOWN_SECONDS=3600
MAX_ACTIVE_SIGNALS=12

# Entry / risk
ATR_SL_MULTIPLIER=1.8
ATR_TP_MULTIPLIER=3.6
MIN_RISK_REWARD=1.8
RISK_PER_TRADE_PCT=1.0
MAX_POSITION_PCT=15.0
MAX_LEVERAGE=10
MAX_RISK_SCORE_TO_ENTER=6

# Storage
DATA_DIR=./data
DB_PATH=./data/signals_v3.db

# Report / defaults
BEGINNER_MODE_DEFAULT=true
DEFAULT_DEPOSIT_USD=1000

# Telegram (optional; bot is read-only, never executes orders)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# AI reasoning layer (optional; explanation only, never modifies levels/score)
AI_ENABLED=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=20
