# HYPE v3 — Futures Signal Intelligence (USDT perpetual)
# Optional overrides for the production signal engine. Values in root `.env`
# are also read (see v3/config.py). Copy to `.env` — never commit secrets.

# Data mode — ТОЛЬКО РЕАЛЬНЫЕ ДАННЫЕ (дефолт live):
#   live  Bybit -> Binance -> MEXC; если все под отказом — нет анализа,
#         сообщение «Нет реальных данных» + повтор (синтетики НЕТ).
#   auto  те же реальные биржи + публичное обогащение (CoinGecko/F&G/news).
#   demo  УДАЛЁН: стартовая ошибка конфигурации.
MARKET_DATA_MODE=live
HTTP_TIMEOUT_SECONDS=12
HTTP_MAX_RETRIES=3
SCAN_INTERVAL_SECONDS=600
SCAN_TOP=20
SCAN_LIMIT=250
SCAN_MIN_TURNOVER_USD=20000000
SCAN_MIN_VOLUME_USD=5000000
# ⭐ СТРОГИЙ ТОП (stars): только сетапы ≥72 видны в «⭐ ТОП»
SCAN_SHOW_QUALITY_MIN=72
# Тир-осознанные списки (🔥 LONG / 🔻 SHORT): допускают B/C тиры (≥58),
# слабые сетапы подписаны «средний/слабый» — честно, без инфляции оценок.
SCAN_LIST_QUALITY_MIN=58
WATCHLIST_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,DOGEUSDT,LINKUSDT,AVAXUSDT,SUIUSDT,TIAUSDT

# Optional API guard: set to non-empty to require X-API-Token on heavy v3 endpoints.
V3_API_TOKEN=

# Telegram bot access. The bot is PRIVATE: without an allow-list every user is
# rejected. TELEGRAM_ADMIN_CHAT_ID (numeric) is used as a fallback allow-list.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=

# Timeframes (order fast -> slow). Mission map: 5m entry timing / 1h setup / 4h-1d macro.
TIMEFRAMES=5m,15m,1h,4h,1d
ENTRY_TF=15m
INTERMEDIATE_TF=1h
MACRO_TF=4h
ANALYSIS_BARS=400

# Data freshness / liquidity / caching
MAX_DATA_AGE_SECONDS=120
BACKTEST_FUNDING_RATE=0.0002   # per 8h interval, conservative carry cost in backtest
MAX_SPREAD_PCT=0.35
MIN_ORDERBOOK_DEPTH_USD=250000
ORDERBOOK_DEPTH=50
TICKER_CACHE_TTL_SECONDS=10
KLINES_CACHE_TTL_SECONDS=15
ORDERBOOK_CACHE_TTL_SECONDS=5
FUNDING_CACHE_TTL_SECONDS=300
LIQUIDATIONS_CACHE_TTL_SECONDS=60
ETH_CONTEXT_ENABLED=true

# Реальные ликвидации Bybit v5: один публичный WebSocket-коллектор на процесс
# (топики liquidation.<SYMBOL>), реконнект с backoff; без сети/потока — «н/д».
LIQUIDATIONS_WS_ENABLED=true
LIQUIDATIONS_WS_MAX_AGE_SECONDS=900

# ── Ранний отбор «намечающегося движения» (раунд 4) ─────────────
# Сканер теперь ловит монеты ДО разгона: RVOL, сжатие/выход из сжатия,
# консолидация, близость к экстремуму 24h-диапазона, рост OI при спокойной
# цене. Признаки — ранжирование/объяснение, НЕ триггер (гейт не изменён).
SCAN_EMERGENCE_ENABLED=true
SCAN_EMERGENCE_POOL=48        # сколько кандидатов проверяем на 1h свечах
SCAN_EMERGENCE_BARS=120
SCAN_EMERGENCE_BOOST=0.30     # вес готовности импульса в heat сканера
SCAN_EXCLUDE_EXHAUSTED=true    # не отправлять уже выжатые движения в глубокий анализ
WATCHER_SCAN_UNIVERSE=true     # daemon сам сканирует всю ликвидную вселенную
SCAN_AGE_DAYS_MIN=7             # листинг младше → пометка fresh (не отсев)
SCAN_MAJOR_PENALTY=4.0          # штраф мажоров (по WATCHLIST_SYMBOLS)
DIVERSITY_MAX_PER_CLUSTER=1   # сколько кандидатов из одной «корзины» в Stage 2
EMERGENCE_RVOL_WINDOW=20
EMERGENCE_RVOL_MIN=1.5
EMERGENCE_SQUEEZE_LOOKBACK=8
EMERGENCE_CONSOLIDATION_BARS=12
EMERGENCE_CONSOLIDATION_ATR=1.6
EMERGENCE_COMPRESSION_ATR_RATIO=0.80
EMERGENCE_BREAKOUT_LOOKBACK=20
EMERGENCE_MAX_TRIGGER_ATR=0.75
EMERGENCE_MIN_BREAKOUT_PRESSURE=0.25
EMERGENCE_MAX_RECENT_MOVE_ATR=2.5
EMERGENCE_MIN_ROOM_PCT=0.15
EMERGENCE_IGNITION_MIN=50

# Positioning-матрица «кто и где стоит» (OI × funding × цена)
OI_CHANGE_BUILD_PCT=2.0       # рост OI за 24h => построение позиций
OI_CHANGE_UNWIND_PCT=-2.0     # падение OI => закрытие позиций
POSITIONING_QUIET_PRICE_CHANGE_PCT=2.0
LIQ_ACCELERATION_WINDOW_SEC=300

# Scoring / no-trade
CONFIDENCE_MIN=0.45
QUALITY_MIN=55
S_TIER_MIN=82
A_TIER_MIN=72
B_TIER_MIN=62
C_TIER_MIN=50
SHOW_TIER_MIN=72
COOLDOWN_SECONDS=3600
MAX_ACTIVE_SIGNALS=12

# Entry / risk
ATR_SL_MULTIPLIER=1.8
ATR_TP_MULTIPLIER=3.6
MIN_RISK_REWARD=1.8
# Смягчённый R:R только для разворотных сценариев (CHoCH / sweep / range);
# трендовый пробой и дальше требует MIN_RISK_REWARD.
MIN_RISK_REWARD_REVERSAL=1.5
RISK_PER_TRADE_PCT=1.0
MAX_POSITION_PCT=15.0
MAX_LEVERAGE=10
MAX_RISK_SCORE_TO_ENTER=6

# Storage
DATA_DIR=./data
DB_PATH=./data/signals_v3.db

# Report / defaults
BEGINNER_MODE_DEFAULT=true
DEFAULT_DEPOSIT_USD=1000

# AI reasoning layer (optional; explanation only, never modifies levels/score)
AI_ENABLED=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=20
