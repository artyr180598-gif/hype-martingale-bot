# ============================================================
#  HYPE FUTURES ENGINE (единый движок v3)
#  Скопируйте в .env и заполните нужное.
#  ТОЛЬКО РЕАЛЬНЫЕ ДАННЫЕ: публичные API бирж работают без ключей;
#  демо-режим удалён (раунд 3) — синтетики в платформе нет.
#
#  Полный список v3-переменных: v3/.env.example
#  Поддерживаемые алиасы: TELEGRAM_TOKEN, BYBIT_KEY, BYBIT_SECRET и т.д.
# ============================================================

# ── TELEGRAM (bot не торгует; только аналитика/уведомления) ──
# Алиасы: TELEGRAM_TOKEN вместо TELEGRAM_BOT_TOKEN,
#         TELEGRAM_CHAT_ID вместо TELEGRAM_ADMIN_CHAT_ID.
# ВАЖНО: бот ЗАКРЫТ. Укажите разрешённые Telegram user IDs (через запятую).
# Если TELEGRAM_ALLOWED_USER_IDS пуст — используется числовой
# TELEGRAM_ADMIN_CHAT_ID; если пусто и то, и другое — доступ закрыт для всех.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=

# ── БИРЖИ (публичные данные без ключей) ─────────────────────
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=false
BINANCE_API_KEY=
BINANCE_API_SECRET=
MEXC_API_KEY=
MEXC_API_SECRET=

# ── РЕЖИМ ДАННЫХ (ТОЛЬКО РЕАЛЬНЫЕ) ──────────────────────────
# live — Bybit → Binance → MEXC (реальные данные; при отказе всех — ошибка,
#         бот показывает «Нет реальных данных» и предлагает повторить).
# auto — те же реальные биржи + публичное обогащение (CoinGecko, Fear&Greed,
#         CryptoCompare). Синтетической подмены нет и здесь.
# demo — УДАЛЁН: запуск с этим значением завершится ошибкой конфигурации.
MARKET_DATA_MODE=live

# ── ХРАНЕНИЕ (SQLite) ───────────────────────────────────────
DATA_DIR=./data

# ── WEB / API ───────────────────────────────────────────────
HOST=0.0.0.0
# Railway сам инжектит PORT; дефолт 8400.
PORT=8400

# ── ЕДИНЫЙ ДВИЖОК ───────────────────────────────────────────
# daemon (default) | serve | watch | bot | scan | signal | backtest | walkforward | calibrate | status
V3_COMMAND=daemon

# ── РАННИЙ ИМПУЛЬС ──────────────────────────────────────────
# daemon сканирует всю ликвидную вселенную; `watch BTCUSDT,ETHUSDT` остаётся
# точечным режимом. Анализируется только закрытая свеча, чтобы не ловить repaint.
WATCHER_SCAN_UNIVERSE=true
SCAN_EXCLUDE_EXHAUSTED=true
EMERGENCE_COMPRESSION_ATR_RATIO=0.80
EMERGENCE_BREAKOUT_LOOKBACK=20
EMERGENCE_MAX_TRIGGER_ATR=0.75
EMERGENCE_MIN_BREAKOUT_PRESSURE=0.25
EMERGENCE_MAX_RECENT_MOVE_ATR=2.5
EMERGENCE_MIN_ROOM_PCT=0.15

# ── «Уверенность бота» (раунд 6) ────────────────────────────────
# Сводный процент: насколько независимые анализы согласны между собой.
# Веса нормируются автоматически (сумма = 1.0), шкала слов настраивается.
BOT_CONFIDENCE_WEIGHTS=quality:0.34,data:0.16,trend:0.16,confirm:0.14,risk:0.10,impulse:0.10
BOT_CONFIDENCE_HIGH_MIN=75      # ≥ — «высокая»
BOT_CONFIDENCE_MEDIUM_MIN=55    # ≥ — «умеренная»
BOT_CONFIDENCE_LOW_MIN=35       # < — «очень низкая»

# ── Авто-сигналы (раунд 6): бот пишет сам, без запроса ──────────
# Фоновый сканер обходит вселенную каждые WATCHER_INTERVAL_SECONDS и шлёт
# уведомление ТОЛЬКО если сетап прошёл все пороги ниже. Остальное остаётся
# в разделах «⭐ ТОП / 🔥 LONG / 🔻 SHORT».
ALERTS_ENABLED=true
WATCHER_INTERVAL_SECONDS=180    # как часто бот сам сканирует рынок (сек)
# Важно про нагрузку: за один цикл бот делает Stage 1 (тикеры) + emergence-пул
# (SCAN_EMERGENCE_POOL свечных запросов) + глубокий анализ SCAN_TOP монет.
# При 180с это ~2–3 запроса/с в среднем — публичные лимиты Bybit выдерживают,
# 429 обрабатывается backoff'ом. Если хотите реже/легче — увеличьте интервал
# или уменьшите SCAN_TOP / SCAN_EMERGENCE_POOL. Циклы не накладываются друг на
# друга: следующий стартует через интервал ПОСЛЕ завершения предыдущего.

ALERT_MIN_QUALITY=78            # оценка сетапа (A и выше)
ALERT_MIN_BOT_CONFIDENCE=70     # уверенность бота, %
ALERT_MIN_DATA_CONFIDENCE=0.60  # полнота реальных данных 0..1
ALERT_MAX_RISK_SCORE=6          # риск-скор не выше
ALERT_MIN_RR=1.8                # потенциал к риску (не мягче MIN_RISK_REWARD)
ALERT_REQUIRE_FRESH=true        # не слать сетап по устаревшим данным
ALERT_MAX_PER_CYCLE=3           # не более N уведомлений за цикл
# Куда доставлять (через запятую). Пусто — используется TELEGRAM_ADMIN_CHAT_ID.
ALERT_CHAT_IDS=


# Опциональная защита тяжёлых API-эндпоинтов заголовком X-API-Token.
V3_API_TOKEN=
