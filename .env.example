# ============================================================
#  HYPE ULTIMATE v4 — Multi-exchange scanner
#  Портирован из лучших проектов GitHub:
#  - freqtrade/freqtrade (54.7k stars) — архитектура, риск, бэктест
#  - CryptoMarius/CryptoScanBot — STOBB/SBM/JUMP, мультибиржа
#  - Haehnchen/crypto-trading-bot — multi-pair, long/short, web UI
#  - chibyk71/crypto-scanner — multi-timeframe, scoring, ML
#  - samshoaib123/Trading_Signal_Bot — ATR TP/SL, confidence
#  - OfficialGIGA/crypto-signal-scanner — BTC dominance, correlation
#  - python-telegramBot/crypto-liquidity-ai-trading-bot — liquidity walls, sweeps
# ============================================================

# ── TELEGRAM (закрытый бот) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=
# Алиасы
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ── БИРЖИ (публичные данные без ключей, ключи опционально для приват) ──
EXCHANGES=binance,bybit,okx,mexc,kucoin,gate,bitget
PRIMARY_EXCHANGE=bybit
SECONDARY_EXCHANGES=binance,okx,mexc

BYBIT_API_KEY=
BYBIT_API_SECRET=
BINANCE_API_KEY=
BINANCE_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
MEXC_API_KEY=
MEXC_API_SECRET=
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
GATE_API_KEY=
GATE_API_SECRET=
BITGET_API_KEY=
BITGET_API_SECRET=

# ── РЕЖИМ ──
MARKET_DATA_MODE=live
DATA_DIR=./data
HOST=0.0.0.0
PORT=8400
V3_COMMAND=daemon
API_TOKEN=

# ── СКАНЕР ──
SCAN_LIMIT=300
SCAN_TOP=25
SCAN_MIN_TURNOVER_USD=15000000
SCAN_MIN_VOLUME_USD=5000000
SCAN_SHOW_QUALITY_MIN=70
SCAN_LIST_QUALITY_MIN=55
SCAN_EMERGENCE_POOL=60
SCAN_EMERGENCE_BARS=120
SCAN_EXCLUDE_EXHAUSTED=true
WATCHLIST_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,DOGEUSDT,LINKUSDT,AVAXUSDT,SUIUSDT,TIAUSDT,ARBUSDT,APTUSDT,OPUSDT,INJUSDT

# ── ТАЙМФРЕЙМЫ ──
TIMEFRAMES=5m,15m,1h,4h,1d
ENTRY_TF=15m
INTERMEDIATE_TF=1h
MACRO_TF=4h

# ── ИНДИКАТОРЫ / STOBB/SBM/JUMP ──
STOBB_STOCH_K_MAX=25
STOBB_STOCH_D_MAX=25
STOBB_BB_POS_MAX=0.15
JUMP_PRICE_PCT_MIN=3.0
JUMP_VOLUME_MULT_MIN=2.5
ORDERBOOK_IMBALANCE_BULL=0.65
ORDERBOOK_IMBALANCE_BEAR=0.35
LIQUIDITY_WALL_USD=100000

# ── РАННИЙ ИМПУЛЬС ──
EMERGENCE_RVOL_MIN=1.4
EMERGENCE_COMPRESSION_ATR_RATIO=0.85
EMERGENCE_BREAKOUT_LOOKBACK=20
EMERGENCE_MAX_TRIGGER_ATR=0.85
EMERGENCE_MIN_ROOM_PCT=0.12
EMERGENCE_IGNITION_MIN=48

# ── РИСК ──
ATR_SL_MULTIPLIER=2.2
ATR_TP_MULTIPLIER=3.6
MIN_RISK_REWARD=1.8
MIN_RISK_REWARD_REVERSAL=1.4
MAX_ENTRY_DISTANCE_ATR=1.2
ENTRY_MAX_EXTENSION_ATR=2.2
TP1_R=1.0
TP2_R=2.0
TP3_R=3.2
RISK_PER_TRADE_PCT=1.0
MAX_POSITION_PCT=15.0
MAX_LEVERAGE=10
QUALITY_MIN=52
CONFIDENCE_MIN=0.45
MAX_RISK_SCORE_TO_ENTER=7

# ── УВЕРЕННОСТЬ БОТА ──
BOT_CONFIDENCE_WEIGHTS=quality:0.30,data:0.15,trend:0.20,confirm:0.15,risk:0.10,impulse:0.10
BOT_CONFIDENCE_HIGH_MIN=75
BOT_CONFIDENCE_MEDIUM_MIN=55
BOT_CONFIDENCE_LOW_MIN=35

# ── АВТО-СИГНАЛЫ ──
ALERTS_ENABLED=true
WATCHER_INTERVAL_SECONDS=180
ALERT_MIN_QUALITY=75
ALERT_MIN_BOT_CONFIDENCE=68
ALERT_MIN_DATA_CONFIDENCE=0.55
ALERT_MAX_RISK_SCORE=6
ALERT_MIN_RR=1.8
ALERT_MAX_PER_CYCLE=4
ALERT_CHAT_IDS=

# ── AI ──
AI_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
