# ============================================================
#  HYPE ADVISOR — конфигурация через переменные окружения / .env
#  Скопируйте в .env и заполните нужное. Без ключей бот тоже
#  работает: публичные данные бирж + автопереключение в демо-режим.
#
#  На Railway эти переменные задаются во вкладке Variables.
#  Поддерживаются оба варианта имён (см. AliasChoices в settings.py):
#    TELEGRAM_BOT_TOKEN  или TELEGRAM_TOKEN
#    TELEGRAM_ADMIN_CHAT_ID или TELEGRAM_CHAT_ID
#    BYBIT_API_KEY / BYBIT_KEY,  BYBIT_API_SECRET / BYBIT_SECRET
# ============================================================

# ── TELEGRAM (для бота-советника) ───────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# ── БИРЖИ ───────────────────────────────────────────────────
# Публичные данные (свечи, тикеры, фандинг, стакан) работают БЕЗ ключей.
# Ключи нужны только для приватных эндпоинтов — советник их не использует,
# но если они уже заданы на Railway, бот их подхватит.
# Bybit — основной источник (фьючерсы USDT-perp)
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=false
# Binance — резервный источник (USDⓈ-M фьючерсы)
BINANCE_API_KEY=
BINANCE_API_SECRET=
# MEXC — третий источник
MEXC_API_KEY=
MEXC_API_SECRET=
# CoinGecko — спот-данные (тренды, муверы, капитализация)
COINGECKO_API_KEY=

# ── РЕЖИМ ДАННЫХ ────────────────────────────────────────────
# auto (по умолчанию) — Bybit → Binance → MEXC, при отказе всех демо-рынок
# live  — только живые данные (ошибка, если биржи недоступны)
# demo  — только синтетический рынок (для тестов)
MARKET_DATA_MODE=auto

# ── НАБЛЮДЕНИЕ ──────────────────────────────────────────────
WATCHLIST_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,DOGEUSDT,LINKUSDT,AVAXUSDT,SUIUSDT,TIAUSDT
WATCH_INTERVAL_SECONDS=600
SCAN_INTERVAL_SECONDS=1800
DEEP_ANALYZE_TOP=12
WATCH_MAX_SYMBOLS=30
GEM_PROMOTE_MIN_SCORE=66

# ── ПОРОГИ СОВЕТНИКА ────────────────────────────────────────
ALERT_MIN_SCORE=70
CHART_MIN_SCORE=60
GEM_MIN_VOLUME_USD=20000000
GEM_MIN_SCORE=62

# ── РИСК-ПАРАМЕТРЫ СОВЕТОВ ─────────────────────────────────
# Риск на сделку в % депозита. По этому числу считается объём позиции.
RISK_PER_TRADE_PCT=1.0
# Жёсткий потолок плеча (для новичка бот всё равно не поднимется выше 10x)
MAX_LEVERAGE=10
# Минимальное R:R, ниже которого сделка не рекомендуется
MIN_RISK_REWARD=1.8
# Максимальная доля депозита в марже одной сделки
MAX_POSITION_PCT=15.0

# ── КАРТОЧКА СДЕЛКИ (можно менять кнопками в боте) ──────────
# Депозит нужен, чтобы посчитать «сколько купить в USDT и в монетах».
DEFAULT_DEPOSIT_USD=500
# bybit | binance — под какую биржу писать пошаговую инструкцию
DEFAULT_EXCHANGE=bybit
# futures | spot
DEFAULT_MARKET=futures
# Пусто = плечо подбирается по волатильности
DEFAULT_LEVERAGE=

# ── ХРАНЕНИЕ ───────────────────────────────────────────────
# На Railway файловая система эфемерная: при желании подключите Volume
# и укажите DATA_DIR=/data — тогда настройки и журнал переживут деплой.
DATA_DIR=./data
DB_PATH=./data/advisor.db
CHART_DIR=./data/charts

# ── WEB-ДАШБОРД ─────────────────────────────────────────────
HOST=0.0.0.0
# Railway сам инжектит PORT — не задавайте его вручную.
# Healthcheck, docker-compose и entrypoint читают PORT (по умолчанию 8000).
PORT=8000

# ── ПЕРЕКЛЮЧАТЕЛЬ ВЕРСИЙ ПРИ ДЕПЛОЕ (entrypoint.sh) ─────────
# true  — запускать новую архитектуру: python -m v2 ${V2_COMMAND:-serve}
# false / пусто — классический CEX-советник: python main.py
RUN_V2=false
# Команда v2, когда RUN_V2=true: serve | bot | watch | scan | status
# serve — HTTP/дашборд + Telegram-кнопки v1/v2 ОДНОВРЕМЕННО (если задан
#         TELEGRAM_BOT_TOKEN). Один токен — один поллер.
# bot   — ТОЛЬКО Telegram (без HTTP/healthcheck).
V2_COMMAND=serve

# ── v3: FUTURES SIGNAL INTELLIGENCE (USDT perpetual) ───────────
# Отдельные переменные v3 (пороги скоринга, TF, риски, no-trade) описаны в
# v3/.env.example; корневой .env тоже читается. Ключевые:
# QUALITY_MIN, S_TIER_MIN, A_TIER_MIN, B_TIER_MIN, C_TIER_MIN,
# CONFIDENCE_MIN, MIN_RISK_REWARD, MAX_RISK_SCORE_TO_ENTER,
# AUTO-TRADING НЕ ВКЛЮЧЕНА: v3 только анализирует и пишет сигналы.

# ── v3 (futures signal intelligence) ───────────────────────────
# true  — запустить python -m v3 ${V3_COMMAND:-serve}
# false / пусто — дефолт (RUN_V2 / python main.py)
RUN_V3=false
V3_COMMAND=serve
# v3 serve слушает PORT (тот же, что для healthcheck); по умолчанию 8400
