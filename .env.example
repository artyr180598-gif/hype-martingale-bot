# ============================================================
#  HYPE FUTURES ENGINE (единый движок v3)
#  Скопируйте в .env и заполните нужное.
#  Без ключей работает: публичные данные бирж + демо-режим.
#
#  Полный список v3-переменных: v3/.env.example
#  Поддерживаемые алиасы: TELEGRAM_TOKEN, BYBIT_KEY, BYBIT_SECRET и т.д.
# ============================================================

# ── TELEGRAM (bot не торгует; только аналитика/уведомления) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# ── БИРЖИ (публичные данные без ключей) ─────────────────────
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=false
BINANCE_API_KEY=
BINANCE_API_SECRET=
MEXC_API_KEY=
MEXC_API_SECRET=

# ── РЕЖИМ ДАННЫХ ────────────────────────────────────────────
# auto — Bybit → Binance → MEXC, при отказе всех демо-рынок
# live — только живые данные (ошибка, если биржи недоступны)
# demo — только синтетический рынок
MARKET_DATA_MODE=auto

# ── ХРАНЕНИЕ (SQLite) ───────────────────────────────────────
DATA_DIR=./data

# ── WEB / API ───────────────────────────────────────────────
HOST=0.0.0.0
# Railway сам инжектит PORT; дефолт 8400.
PORT=8400

# ── ЕДИНЫЙ ДВИЖОК ───────────────────────────────────────────
# daemon (default) | serve | watch | bot | scan | signal | backtest | walkforward | calibrate | status
V3_COMMAND=daemon

# Опциональная защита тяжёлых API-эндпоинтов заголовком X-API-Token.
V3_API_TOKEN=
