# ============================================================
#  HYPE ADVISOR — конфигурация через переменные окружения / .env
#  Скопируйте в .env и заполните нужное. Без ключей бот тоже
#  работает: публичные данные бирж + автопереключение в демо-режим.
# ============================================================

# ── TELEGRAM (для бота-советника) ───────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# ── БИРЖИ (публичные данные работают без ключей) ────────────
# Bybit — основной источник (фьючерсы)
BYBIT_API_KEY=
BYBIT_API_SECRET=
# Binance — резервный источник (фьючерсы)
BINANCE_API_KEY=
BINANCE_API_SECRET=
# MEXC — третий источник (фьючерсы)
MEXC_API_KEY=
MEXC_API_SECRET=
# CoinGecko — спот-данные для поиска скрытых монет
COINGECKO_API_KEY=

# ── РЕЖИМ ДАННЫХ ────────────────────────────────────────────
# auto (по умолчанию) — живые данные, при недоступности бирж демо-режим
# live — только живые данные | demo — только синтетический рынок
MARKET_DATA_MODE=auto

# ── НАБЛЮДЕНИЕ ──────────────────────────────────────────────
# Список наблюдения (через запятую). Бот сам добавляет найденные
# скрытые монеты с высоким рейтингом.
WATCHLIST_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,DOGEUSDT,LINKUSDT,AVAXUSDT,SUIUSDT,TIAUSDT
WATCH_INTERVAL_SECONDS=600
SCAN_INTERVAL_SECONDS=1800

# ── ПОРОГИ СОВЕТНИКА ────────────────────────────────────────
ALERT_MIN_SCORE=70
CHART_MIN_SCORE=60
GEM_MIN_VOLUME_USD=20000000
GEM_MIN_SCORE=62

# ── РИСК-ПАРАМЕТРЫ СОВЕТОВ ─────────────────────────────────
RISK_PER_TRADE_PCT=1.0
MAX_LEVERAGE=10
MIN_RISK_REWARD=1.8

# ── ХРАНЕНИЕ ───────────────────────────────────────────────
DATA_DIR=./data
DB_PATH=./data/advisor.db
CHART_DIR=./data/charts

# ── WEB-ДАШБОРД ─────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
