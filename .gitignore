__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.env
# Ignore runtime data directories anywhere in the tree...
data/
# ...but keep the source package `src/data/` tracked. The bare `data/`
# pattern above matches ANY directory named `data`, which previously caused
# the entire src/data/** package to be silently excluded from commits.
!src/data/
!src/data/**
*.log
*.tmp
